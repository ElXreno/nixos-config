diff -ru a/service.luau b/service.luau
--- a/service.luau	2026-11-11 15:10:42.760667312 +0300
+++ b/service.luau	2026-11-11 15:11:05.306917118 +0300
@@ -151,13 +151,58 @@
     isInitialFetch = false
 end
 
-local function fetchDevices()
+local FETCH_TIMEOUT_MS = 15000
+local FETCH_RETRY_LIMIT = 5
+local fetchInFlight = false
+local fetchPending = false
+local fetchRetries = 0
+local fetchDevices
+
+local function handleFetchFailure(res)
+    local code = res and res.exitCode or -1
+    noctalia.log(string.format("udiskie-info failed: exit=%s timedOut=%s stderr=%s", tostring(code), tostring(res and res.timedOut), tostring(res and res.stderr or "")))
+
+    if code == 127 then
+        noctalia.state.set("udiskie_devices", { drives = {}, standalone = {}, raw = {}, error = "missing_dep" })
+        return
+    end
+
+    if fetchRetries < FETCH_RETRY_LIMIT then
+        fetchRetries += 1
+        noctalia.runAsync("sleep 2", function()
+            fetchDevices()
+        end)
+        return
+    end
+
+    noctalia.state.set("udiskie_devices", { drives = {}, standalone = {}, raw = {}, error = "fetch_failed" })
+end
+
+fetchDevices = function()
+    if fetchInFlight then
+        fetchPending = true
+        return
+    end
+    fetchInFlight = true
+
     noctalia.runAsync("udiskie-info -a -o \"{device_file}\t{ui_label}\t{is_mounted}\t{mount_path}\t{is_luks}\t{is_drive}\t{is_partition}\t{is_filesystem}\t{is_detachable}\t{is_ejectable}\t{in_use}\t{device_size}\"", function(res)
+        fetchInFlight = false
+        local again = fetchPending
+        fetchPending = false
+
         if not res or res.exitCode ~= 0 then
-            noctalia.state.set("udiskie_devices", { drives = {}, standalone = {}, raw = {}, error = "missing_dep" })
+            handleFetchFailure(res)
+            if again then
+                fetchDevices()
+            end
             return
         end
 
+        fetchRetries = 0
+        if again then
+            fetchDevices()
+        end
+
         local rawDevices, currentMounted = parseUdiskieOutput(res.stdout)
         local structured = buildHierarchy(rawDevices)
         structured.error = nil
@@ -184,7 +229,7 @@
 
             noctalia.state.set("udiskie_devices", structured)
         end)
-    end, 5000)
+    end, FETCH_TIMEOUT_MS)
 end
 
 -- Initial fetch on startup
@@ -193,7 +238,7 @@
 
 -- Event-driven streaming using udisksctl monitor
 noctalia.runStream("udisksctl monitor 2>/dev/null", function(line)
-    if line:find("Added") or line:find("PropertiesChanged") or line:find("Removed") then
+    if line:find("Added") or line:find("Properties Changed") or line:find("Removed") then
         fetchDevices()
     end
 end)
