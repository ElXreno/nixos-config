{
  config,
  namespace,
  lib,
  ...
}:
let
  inherit (lib) mkOption types;
  cfg = config.${namespace}.tailscale;
  hostTags = if cfg.trusted then cfg.tags else [ "tag:dmz" ];
in
{
  options.${namespace}.tailscale = {
    trusted = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Whether this machine may open connections to the rest of the tailnet.
        An untrusted machine carries only tag:dmz, which the tailnet policy
        lets others reach but grants nothing.
      '';
    };

    tags = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "tag:workstation" ];
      description = "ACL tags of this machine, set by its roles. Ignored on an untrusted machine.";
    };

    deviceTags = mkOption {
      type = types.listOf types.str;
      readOnly = true;
      default = lib.sort lib.lessThan (
        lib.unique (hostTags ++ lib.concatMap (svc: svc.tags) (lib.attrValues cfg.serve))
      );
      defaultText = lib.literalMD "{option}`tags` (or `tag:dmz` when untrusted) and the tags of every {option}`serve` entry.";
      description = "Tags the terranix configuration applies to this machine in the tailnet.";
    };

    serveNode = mkOption {
      type = types.attrsOf (
        types.submodule {
          options.backend = mkOption {
            type = types.str;
            example = "http://localhost:8080";
            description = "Local backend URL behind the port.";
          };

          options.acceptAppCaps = mkOption {
            type = types.listOf types.str;
            default = [ ];
            description = "App capabilities forwarded to the backend in the Tailscale-App-Capabilities header.";
          };

          options.shared = mkOption {
            type = types.bool;
            default = false;
            description = ''
              Whether users this machine is shared with may reach the port;
              the tailnet policy generated by terranix grants it to autogroup:shared.
            '';
          };
        }
      );
      default = { };
      example = {
        "tcp:8443".backend = "http://localhost:8080";
      };
      description = ''
        HTTPS ports of this machine's own tailnet name, keyed by protocol:port.
        Unlike a Tailscale Service they are reachable by users the machine is
        shared with, which Services are not.
      '';
    };

    serve = mkOption {
      type = types.attrsOf (
        types.submodule {
          options.comment = mkOption {
            type = types.str;
            default = "";
            example = "Radarr movie manager";
            description = "Description shown next to the service in the admin console.";
          };

          options.tags = mkOption {
            type = types.listOf types.str;
            default = hostTags;
            defaultText = lib.literalMD "The machine's {option}`tags`, or `tag:dmz` when untrusted.";
            example = [ "tag:nixflix" ];
            description = ''
              ACL tags the service carries. A node holding one of them
              approves itself as a host for the service.
            '';
          };

          options.acceptAppCaps = mkOption {
            type = types.listOf types.str;
            default = [ ];
            example = [ "example.com/cap/app" ];
            description = ''
              App capabilities from the tailnet policy grants that serve
              forwards to the backend in the Tailscale-App-Capabilities header.
            '';
          };

          options.endpoints = mkOption {
            type = types.attrsOf types.str;
            default = { };
            example = {
              "tcp:443" = "http://localhost:8080";
            };
            description = ''
              Mapping of protocol:port to local backend URL.
              Tailscale terminates TLS and proxies to the backend.
            '';
          };
        }
      );
      default = { };
      description = ''
        Tailscale Services to expose from this machine. Each key is a
        service name (e.g. "svc:radarr"). The tailnet side of every
        declaration here is generated by the terranix configuration,
        which reads this option from every machine.
      '';
    };
  };
}
