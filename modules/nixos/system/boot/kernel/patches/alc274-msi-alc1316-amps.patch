+};
+
+static void alc274_msi_amp_write(struct hda_codec *codec,
+				 const struct alc274_msi_amp_write *w)
+{
+	const struct coef_fw seq[] = {
+		WRITE_COEF(0x24, w->dev), WRITE_COEF(0x25, 0x0000),
+		WRITE_COEF(0x26, w->reg), WRITE_COEF(0x27, 0x0000),
+		WRITE_COEF(0x28, w->val), WRITE_COEF(0x29, 0xb023),
+		{}
+	};
+	int i;
+
+	alc_process_coef_fw(codec, seq);
+	for (i = 0; i < 10; i++) {
+		if (!(alc_read_coef_idx(codec, 0x29) & 0x0020))
+			return;
+		usleep_range(100, 200);
+	}
+	codec_warn(codec, "ALC1316 0x%02x: write 0x%04x=0x%02x timed out\n",
+		   w->dev, w->reg, w->val);
+}
+
+static void alc274_msi_amp_seq(struct hda_codec *codec,
+			       const struct alc274_msi_amp_write *seq, int len)
+{
+	int i;
+
+	for (i = 0; i < len; i++)
+		alc274_msi_amp_write(codec, &seq[i]);
+}
+
+static void alc274_msi_amps_init(struct hda_codec *codec)
+{
+	struct alc_spec *spec = codec->spec;
+
+	alc_update_coef_idx(codec, 0x10, 0, 1 << 15);
+	alc_update_coef_idx(codec, 0x10, 0, 1 << 14);
+	alc_update_coef_idx(codec, 0x10, 1 << 14, 0);
+	alc274_msi_amp_seq(codec, alc274_msi_amp_init_seq,
+			   ARRAY_SIZE(alc274_msi_amp_init_seq));
+	alc_update_coef_idx(codec, 0x10, 0, 1 << 14);
+	if (!spec->gen.active_streams)
+		alc274_msi_amp_seq(codec, alc274_msi_amp_off_seq,
+				   ARRAY_SIZE(alc274_msi_amp_off_seq));
+}
+
+static void alc274_msi_amp_playback_hook(struct hda_pcm_stream *hinfo,
+					 struct hda_codec *codec,
+					 struct snd_pcm_substream *substream,
+					 int action)
+{
+	struct alc_spec *spec = codec->spec;
+
+	switch (action) {
+	case HDA_GEN_PCM_ACT_OPEN:
+		if (!spec->gen.active_streams)
+			break;
+		alc_update_coef_idx(codec, 0x10, 1 << 14, 0);
+		alc274_msi_amp_seq(codec, alc274_msi_amp_on_seq,
+				   ARRAY_SIZE(alc274_msi_amp_on_seq));
+		alc_update_coef_idx(codec, 0x10, 0, 1 << 14);
+		break;
+	case HDA_GEN_PCM_ACT_CLOSE:
+		if (spec->gen.active_streams)
+			break;
+		alc274_msi_amp_seq(codec, alc274_msi_amp_off_seq,
+				   ARRAY_SIZE(alc274_msi_amp_off_seq));
+		break;
+	}
+}
+
+static void alc274_fixup_msi_alc1316(struct hda_codec *codec,
+				     const struct hda_fixup *fix, int action)
+{
+	struct alc_spec *spec = codec->spec;
+
+	switch (action) {
+	case HDA_FIXUP_ACT_PROBE:
+		alc274_msi_amps_init(codec);
+		spec->gen.pcm_playback_hook = alc274_msi_amp_playback_hook;
+		break;
+	case HDA_FIXUP_ACT_INIT:
+		if (is_s3_resume(codec) || is_s4_resume(codec))
+			alc274_msi_amps_init(codec);
+		break;
+	}
+}
