From 9589c80b9986c46b25e30f3d5aa28347368bf08c Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Mon, 28 Sep 2026 13:03:48 +0300
Subject: [PATCH] sched/cputime: Don't account the first tick after
 dyntick-idle exit in full

---
 kernel/sched/cputime.c | 36 +++++++++++++++++++++++++++++++-----
 1 file changed, 31 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/cputime.c b/kernel/sched/cputime.c
index 06bddaa..a2b2596 100644
--- a/kernel/sched/cputime.c
+++ b/kernel/sched/cputime.c
@@ -381,9 +381,9 @@ void thread_group_cputime(struct task_struct *tsk, struct task_cputime *times)
  * softirq as those do not count in task exec_runtime any more.
  */
 static void irqtime_account_process_tick(struct task_struct *p, int user_tick,
-					 int ticks)
+					 u64 cputime)
 {
-	u64 other, cputime = TICK_NSEC * ticks;
+	u64 other;
 
 	/*
 	 * When returning from idle, many ticks can get accounted at
@@ -418,10 +418,29 @@ static void irqtime_account_process_tick(struct task_struct *p, int user_tick,
 
 #else /* !CONFIG_IRQ_TIME_ACCOUNTING: */
 static inline void irqtime_account_process_tick(struct task_struct *p, int user_tick,
-						int nr_ticks) { }
+						u64 cputime) { }
 #endif /* !CONFIG_IRQ_TIME_ACCOUNTING */
 
 #if defined(CONFIG_NO_HZ_COMMON) && !defined(CONFIG_HAVE_VIRT_CPU_ACCOUNTING_IDLE)
+static DEFINE_PER_CPU(u64, kcpustat_dyntick_exit);
+
+/* The first tick after dyntick-idle exit only covers the time since the exit */
+static inline u64 kcpustat_tick_cputime(void)
+{
+	u64 exit = __this_cpu_read(kcpustat_dyntick_exit);
+	u64 now;
+
+	if (!exit)
+		return TICK_NSEC;
+
+	__this_cpu_write(kcpustat_dyntick_exit, 0);
+	now = ktime_get_ns();
+	if (now <= exit)
+		return 0;
+
+	return min_t(u64, now - exit, TICK_NSEC);
+}
+
 static void kcpustat_idle_stop(struct kernel_cpustat *kc, u64 now)
 {
 	u64 *cpustat = kc->cpustat;
@@ -475,6 +494,7 @@ void kcpustat_dyntick_stop(u64 now)
 	if (!vtime_generic_enabled_this_cpu()) {
 		WARN_ON_ONCE(!kc->idle_dyntick);
 		kcpustat_idle_stop(kc, now);
+		__this_cpu_write(kcpustat_dyntick_exit, now);
 		kc->idle_dyntick = false;
 		vtime_dyntick_stop();
 	}
@@ -555,6 +575,11 @@ u64 kcpustat_field_iowait(int cpu)
 }
 EXPORT_SYMBOL_GPL(kcpustat_field_iowait);
 #else
+static inline u64 kcpustat_tick_cputime(void)
+{
+	return TICK_NSEC;
+}
+
 static u64 kcpustat_field_dyntick(int cpu, enum cpu_usage_stat idx,
 				  bool compute_delta, ktime_t now)
 {
@@ -695,12 +720,13 @@ void account_process_tick(struct task_struct *p, int user_tick)
 	if (kcpustat_idle_dyntick())
 		return;
 
+	cputime = kcpustat_tick_cputime();
+
 	if (irqtime_enabled()) {
-		irqtime_account_process_tick(p, user_tick, 1);
+		irqtime_account_process_tick(p, user_tick, cputime);
 		return;
 	}
 
-	cputime = TICK_NSEC;
 	steal = steal_account_process_time(ULONG_MAX);
 
 	if (steal >= cputime)
