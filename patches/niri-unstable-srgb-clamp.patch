+
+fn resolve_srgb_clamp(
+    device: &DrmDevice,
+    connector: connector::Handle,
+    config: &niri_config::Output,
+    gamma_props: Option<&GammaProps>,
+) -> Option<srgb_clamp::Clamp> {
+    let clamp = config.srgb_clamp.as_ref()?;
+
+    if !gamma_props.is_some_and(GammaProps::can_encode) {
+        warn!("srgb-clamp: no GAMMA_LUT on this CRTC, colors would stay linear");
+        return None;
+    }
+
+    if let Some(path) = &clamp.correction {
+        let text = std::fs::read_to_string(path)
+            .map_err(|err| warn!("srgb-clamp: couldn't read {path}: {err}"))
+            .ok()?;
+        let correction = srgb_clamp::Clamp::from_matrix_ramp(&text, 2.2).or_else(|| {
+            warn!("srgb-clamp: {path} is not a matrix and ramp correction");
+            None
+        })?;
+        info!("srgb-clamp: applying {path} with {:?}", correction.matrix);
+        return Some(correction);
+    }
+
+    let chromaticities = if let Some(primaries) = &clamp.primaries {
+        srgb_clamp::Chromaticities::from_config(primaries).or_else(|| {
+            warn!("srgb-clamp: configured primaries are out of range");
+            None
+        })?
+    } else {
+        let info = get_edid_info(device, connector)
+            .map_err(|err| warn!("srgb-clamp: couldn't read EDID: {err:?}"))
+            .ok()?;
+        let edid = info.edid().or_else(|| {
+            warn!("srgb-clamp: display has no EDID base block");
+            None
+        })?;
+        srgb_clamp::Chromaticities::from_edid(&edid.chromaticity_coords()).or_else(|| {
+            warn!("srgb-clamp: EDID has no usable chromaticity coordinates");
+            None
+        })?
+    };
+
+    let area = chromaticities.area();
+    let srgb_area = srgb_clamp::SRGB.area();
+    if area <= srgb_area {
+        warn!(
+            "srgb-clamp: display gamut is not wider than sRGB ({:.2}x), refusing to clamp",
+            area / srgb_area
+        );
+        return None;
+    }
+
+    let matrix = srgb_clamp::clamp_matrix(chromaticities).or_else(|| {
+        warn!("srgb-clamp: degenerate primaries");
+        None
+    })?;
+
+    info!(
+        "srgb-clamp: display gamut is {:.2}x sRGB, clamping with {matrix:?}",
+        area / srgb_area
+    );
+
+    Some(srgb_clamp::Clamp::srgb(matrix))
+}
