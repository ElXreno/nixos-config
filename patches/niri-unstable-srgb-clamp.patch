+        self.replace_blobs(device, ctm_blob, degamma_blob);
+
+        Ok(())
+    }
+
+    fn replace_blobs(
+        &mut self,
+        device: &DrmDevice,
+        ctm: Option<NonZeroU64>,
+        degamma: Option<NonZeroU64>,
+    ) {
