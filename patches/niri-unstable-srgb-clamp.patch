+impl CtmProps {
+    fn new(device: &DrmDevice, crtc: crtc::Handle) -> anyhow::Result<Self> {
+        let mut ctm = None;
+        let mut degamma_lut = None;
+        let mut degamma_lut_size = None;
+
+        let props = device
+            .get_properties(crtc)
+            .context("error getting properties")?;
+        for (prop, value) in props {
+            let Ok(info) = device.get_property(prop) else {
+                continue;
+            };
+
+            let Ok(name) = info.name().to_str() else {
+                continue;
+            };
+
+            match name {
+                "CTM" => {
+                    ensure!(
+                        matches!(info.value_type(), property::ValueType::Blob),
+                        "wrong CTM value type"
+                    );
+                    ctm = Some(prop);
+                }
+                "DEGAMMA_LUT" => {
+                    ensure!(
+                        matches!(info.value_type(), property::ValueType::Blob),
+                        "wrong DEGAMMA_LUT value type"
+                    );
+                    degamma_lut = Some(prop);
+                }
+                "DEGAMMA_LUT_SIZE" => {
+                    ensure!(
+                        matches!(info.value_type(), property::ValueType::UnsignedRange(_, _)),
+                        "wrong DEGAMMA_LUT_SIZE value type"
+                    );
+                    degamma_lut_size = Some(value as u32);
+                }
+                _ => (),
+            }
+        }
+
+        let ctm = ctm.context("missing CTM property")?;
+        let degamma_lut = degamma_lut.context("missing DEGAMMA_LUT property")?;
+        let degamma_lut_size = degamma_lut_size.context("missing DEGAMMA_LUT_SIZE property")?;
+
+        Ok(Self {
+            crtc,
+            ctm,
+            degamma_lut,
+            degamma_lut_size,
+            previous_ctm_blob: None,
+            previous_degamma_blob: None,
+            clamp: None,
+        })
+    }
+
+    fn set_blob(
+        &mut self,
+        device: &DrmDevice,
+        prop: property::Handle,
+        data: Option<&mut [u8]>,
+        which: &'static str,
+    ) -> anyhow::Result<Option<NonZeroU64>> {
+        let blob = if let Some(data) = data {
+            let blob = drm_ffi::mode::create_property_blob(device.as_fd(), data)
+                .context("error creating property blob")?;
+            NonZeroU64::new(u64::from(blob.blob_id))
+        } else {
+            None
+        };
+
+        let raw = blob.map(NonZeroU64::get).unwrap_or(0);
+        device
+            .set_property(self.crtc, prop, property::Value::Blob(raw).into())
+            .with_context(|| format!("error setting {which}"))
+            .inspect_err(|_| {
+                if raw != 0 {
+                    if let Err(err) = device.destroy_property_blob(raw) {
+                        warn!("error destroying {which} property blob: {err:?}");
+                    }
+                }
+            })?;
+
+        Ok(blob)
+    }
+
+    fn set_clamp(
+        &mut self,
+        device: &DrmDevice,
+        clamp: Option<srgb_clamp::Clamp>,
+    ) -> anyhow::Result<()> {
+        let _span = tracy_client::span!("CtmProps::set_clamp");
+
+        self.clamp = clamp.clone();
+
+        let Some(clamp) = clamp else {
+            let ctm = self.set_blob(device, self.ctm, None, "CTM")?;
+            let degamma = self.set_blob(device, self.degamma_lut, None, "DEGAMMA_LUT")?;
+            self.replace_blobs(device, ctm, degamma);
+            return Ok(());
+        };
+
+        let degamma_size = self.degamma_lut_size as usize;
+        ensure!(degamma_size > 1, "degamma LUT too small");
