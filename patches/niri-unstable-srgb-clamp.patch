+        #[allow(non_camel_case_types)]
+        #[repr(C)]
+        #[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+        struct drm_color_ctm {
+            matrix: [u64; 9],
+        }
+
+        #[allow(non_camel_case_types)]
+        #[repr(C)]
+        #[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+        struct drm_color_lut {
+            red: u16,
+            green: u16,
+            blue: u16,
+            reserved: u16,
+        }
+
+        let mut ctm_data = [drm_color_ctm {
+            matrix: srgb_clamp::to_drm_ctm(clamp.matrix),
