+/// Value of the NVIDIA `dithering mode` connector property.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Dithering {
+    Auto,
+    Off,
+    Static2x2,
+    Dynamic2x2,
+    Temporal,
+    On,
+}
+
+impl Dithering {
+    /// Name of the matching DRM property enum value.
+    pub fn property_value(self) -> &'static str {
+        match self {
+            Self::Auto => "auto",
+            Self::Off => "off",
+            Self::Static2x2 => "static 2x2",
+            Self::Dynamic2x2 => "dynamic 2x2",
+            Self::Temporal => "temporal",
+            Self::On => "on",
+        }
+    }
+}
+
+impl FromStr for Dithering {
+    type Err = miette::Error;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "auto" => Ok(Self::Auto),
+            "off" => Ok(Self::Off),
+            "static-2x2" => Ok(Self::Static2x2),
+            "dynamic-2x2" => Ok(Self::Dynamic2x2),
+            "temporal" => Ok(Self::Temporal),
+            "on" => Ok(Self::On),
+            _ => Err(miette!(
+                r#"invalid dithering, can be "auto", "off", "static-2x2", "dynamic-2x2", "temporal" or "on""#
+            )),
+        }
+    }
+}
