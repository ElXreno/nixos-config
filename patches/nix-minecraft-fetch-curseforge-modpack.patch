diff --git a/pkgs/tools/fetchCurseForgeModpack/default.nix b/pkgs/tools/fetchCurseForgeModpack/default.nix
new file mode 100644
index 0000000..44d3a53
--- /dev/null
+++ b/pkgs/tools/fetchCurseForgeModpack/default.nix
@@ -0,0 +1,237 @@
+{
+  lib,
+  stdenvNoCC,
+  fetchurl,
+  unzip,
+  neoforgeServers,
+  fabricServers,
+  quiltServers,
+}:
+
+let
+  # CF modpack loader IDs use dotted versions ("21.1.224"); nix-minecraft
+  # server attrs use underscored ones ("21_1_224").
+  attrVersion = lib.replaceStrings [ "." ] [ "_" ];
+
+  # Loader types we can resolve to a nix-minecraft server package set.
+  # Legacy Forge isn't in nix-minecraft, so forge-based modpacks land here
+  # with serverPackage = null and the user must wire their own server jar.
+  loaderToServerSet = {
+    neoforge = neoforgeServers;
+    fabric = fabricServers;
+    quilt = quiltServers;
+  };
+
+  # Pinned copy of itzg's curated client-only slug list. itzg ships this
+  # at /image/cf-exclude-include.json inside docker-minecraft-server and
+  # auto-loads it during AUTO_CURSEFORGE installs. We mirror the same
+  # default. Override via the cfExcludeInclude argument.
+  defaultCfExcludeInclude = fetchurl {
+    name = "cf-exclude-include.json";
+    url = "https://raw.githubusercontent.com/itzg/docker-minecraft-server/a44c7170412d489f51360f0641c84f525ad6acce/files/cf-exclude-include.json";
+    sha256 = "sha256-V8m2M7//cj2gDZRCvkrDVsoy4yeOw3Sp6tl6TPIvEMw=";
+  };
+
+  fetchCurseForgeModpack =
+    {
+      # Path to a local CurseForge modpack ZIP (or a derivation/store path
+      # produced by fetchurl). Provides manifest.json + overrides/.
+      src,
+      # Path to a JSON lockfile with the schema:
+      #   {
+      #     "minecraft": "1.21.1",
+      #     "loader": { "type": "neoforge", "version": "21.1.224" },
+      #     "files": [{ "pid", "fid", "slug", "filename", "sha1", "url", "side" }]
+      #   }
+      # `side` is one of "server" | "client" | "both" (derived by
+      # nix-curseforge-genlocks from CF API gameVersions tags).
+      # Generated by `nix-curseforge-genlocks <zip-or-url> locks.json`.
+      locks,
+      # Which side to assemble. "server" excludes side="client" entries,
+      # "client" excludes side="server" entries, "both" includes everything.
+      side ? "server",
+      # Path to a cf-exclude-include.json file (same schema as
+      # itzg/docker-minecraft-server's files/cf-exclude-include.json).
+      # Mods whose CF slug appears in `.globalExcludes` are dropped from
+      # the assembled output. Mods listed in `.globalForceIncludes` bypass
+      # the side-based and slug-based filters.
+      # Defaults to a pinned copy of itzg's upstream list. Override with
+      # your own `pkgs.fetchurl`-fetched file (or set to null to disable).
+      cfExcludeInclude ? defaultCfExcludeInclude,
+      # Extra exclusions on top of side + cf-exclude-include filters. List
+      # of project IDs (integers), CF slugs (strings), or jar filenames
+      # (strings) to forcibly drop. Use for mods that aren't covered by
+      # itzg's curated list but still need exclusion.
+      extraExcludes ? [ ],
+      # Counterpart to extraExcludes: list of pids/slugs/filenames to
+      # forcibly include (overrides side + slug filters). Mirrors itzg's
+      # CF_FORCE_INCLUDE_MODS.
+      extraForceIncludes ? [ ],
+      ...
+    }@args:
+
+    assert lib.assertMsg (builtins.elem side [
+      "server"
+      "client"
+      "both"
+    ]) "'side' must be one of: server, client, both";
+
+    let
+      locksData = lib.importJSON locks;
+      pname = args.pname or "curseforge-pack";
+      version = args.version or "";
+
+      mcAttr = attrVersion locksData.minecraft;
+      loaderAttr = attrVersion locksData.loader.version;
+      # Fabric and Quilt server sets carry one attr per game version, built
+      # against the latest loader; the loader version is picked via override.
+      isTextile = builtins.elem locksData.loader.type [
+        "fabric"
+        "quilt"
+      ];
+      serverAttr =
+        if isTextile then
+          "${locksData.loader.type}-${mcAttr}"
+        else
+          "${locksData.loader.type}-${mcAttr}-${loaderAttr}";
+      serverSet = loaderToServerSet.${locksData.loader.type} or null;
+      serverPackage =
+        if serverSet == null || !(serverSet ? ${serverAttr}) then
+          null
+        else if isTextile then
+          serverSet.${serverAttr}.override { loaderVersion = locksData.loader.version; }
+        else
+          serverSet.${serverAttr};
+
+      # Filter lockfile entries by requested side, the cf-exclude-include
+      # slug list, and user-supplied extra excludes/includes.
+      includedFiles =
+        let
+          excludeSide =
+            if side == "server" then "client"
+            else if side == "client" then "server"
+            else null;
+
+          cfData = if cfExcludeInclude == null then { } else lib.importJSON cfExcludeInclude;
+          cfGlobalExcludes = cfData.globalExcludes or [ ];
+          cfGlobalForceIncludes = cfData.globalForceIncludes or [ ];
+
+          # Build a lookup set keyed by stringified pid, slug, or filename.
+          # Each entry in the user-supplied list may be any of the three.
+          mkLookup = entries: builtins.listToAttrs (
+            map (e: { name = toString e; value = true; }) entries
+          );
+          matchesAny = lookup: m:
+            (lookup.${toString m.pid} or false)
+            || (lookup.${m.slug or ""} or false)
+            || (lookup.${m.filename} or false);
+
+          excludeLookup = mkLookup (cfGlobalExcludes ++ extraExcludes);
+          forceIncludeLookup = mkLookup (cfGlobalForceIncludes ++ extraForceIncludes);
+
+          isSideExcluded = m: excludeSide != null && (m.side or "both") == excludeSide;
+          isExcluded = m: isSideExcluded m || matchesAny excludeLookup m;
+          isForceIncluded = m: matchesAny forceIncludeLookup m;
+        in
+        builtins.filter (m: isForceIncluded m || !(isExcluded m)) locksData.files;
+
+      # Per-mod content-addressed FOD via fetchurl. Identical {sha1} across
+      # modpacks resolves to the same /nix/store path → cross-modpack sharing.
+      mkModDrv =
+        m:
+        fetchurl {
+          name = m.filename;
+          url = m.url;
+          sha1 = m.sha1;
+        };
+
+      mods = map mkModDrv includedFiles;
+
+      drv = stdenvNoCC.mkDerivation {
+        inherit pname version src;
+        nativeBuildInputs = [ unzip ];
+
+        unpackPhase = ''
+          runHook preUnpack
+
+          if [ -d "$src" ]; then
+            cp -r "$src" pack-src
+            chmod -R u+w pack-src
+          else
+            mkdir -p pack-src
+            unzip -q "$src" -d pack-src
+          fi
+
+          runHook postUnpack
+        '';
+
+        buildPhase = ''
+          set -euo pipefail
+          runHook preBuild
+
+          mkdir -p out/mods
+
+          ${lib.concatMapStringsSep "\n" (m: ''
+            ln -s ${mkModDrv m} out/mods/${lib.escapeShellArg m.filename}
+          '') includedFiles}
+
+          if [ -d pack-src/overrides ]; then
+            cp -r pack-src/overrides/. out/
+          fi
+
+          runHook postBuild
+        '';
+
+        installPhase = ''
+          runHook preInstall
+          mkdir -p $out
+          cp -r out/. $out/
+          runHook postInstall
+        '';
+
+        passthru = {
+          inherit mods serverPackage serverAttr;
+          inherit (locksData) minecraft loader;
+          locks = locksData;
+
+          # Add files (e.g. side-mods from Modrinth) on top of the assembled
+          # modpack. Mirrors fetchPackwizModpack/fetchModrinthModpack.
+          addFiles =
+            files:
+            stdenvNoCC.mkDerivation {
+              inherit (drv) pname version;
+              src = null;
+              dontUnpack = true;
+              dontConfig = true;
+              dontBuild = true;
+              dontFixup = true;
+
+              installPhase = ''
+                cp -as "${drv}" $out
+                chmod u+w -R $out
+              ''
+              + lib.concatLines (
+                lib.mapAttrsToList (name: file: ''
+                  mkdir -p "$out/$(dirname "${name}")"
+                  cp -as "${file}" "$out/${name}"
+                '') files
+              );
+
+              passthru = {
+                inherit (drv)
+                  mods
+                  locks
+                  minecraft
+                  loader
+                  serverPackage
+                  serverAttr
+                  ;
+              };
+              meta = drv.meta or { };
+            };
+        };
+      };
+    in
+    drv;
+in
+fetchCurseForgeModpack
diff --git a/pkgs/tools/nix-curseforge-genlocks.nix b/pkgs/tools/nix-curseforge-genlocks.nix
new file mode 100644
index 0000000..c6b784d
--- /dev/null
+++ b/pkgs/tools/nix-curseforge-genlocks.nix
@@ -0,0 +1,238 @@
+{
+  writeShellApplication,
+  curl,
+  jq,
+  unzip,
+  coreutils,
+  nix,
+}:
+writeShellApplication {
+  name = "nix-curseforge-genlocks";
+
+  runtimeInputs = [
+    curl
+    jq
+    unzip
+    coreutils
+    nix
+  ];
+
+  text = ''
+    set -euo pipefail
+
+    if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
+      cat <<'EOF' >&2
+    nix-curseforge-genlocks <zip-or-url> [output.json]
+
+    Reads manifest.json from a CurseForge modpack and emits a lockfile
+    consumable by fetchCurseForgeModpack.
+
+    The first argument is either a local modpack ZIP path or a URL (any URL
+    that resolves to a modpack ZIP works, including the CurseForge website
+    redirect endpoint, e.g.
+      https://www.curseforge.com/api/v1/mods/925200/files/7892974/download
+    or a direct CDN URL).
+
+    The lockfile is an array of { pid, fid, filename, sha1, url } objects
+    sorted by fid. Default output path: ./locks.json.
+
+    Requires CF_API_KEY in the environment. Get one at
+    https://console.curseforge.com/.
+
+    On success a paste-ready Nix snippet wiring fetchCurseForgeModpack +
+    fetchurl (with the ZIP's sha256) is printed to stderr.
+    EOF
+      exit 1
+    fi
+
+    if [ -z "''${CF_API_KEY:-}" ]; then
+      echo "error: CF_API_KEY environment variable is required" >&2
+      exit 1
+    fi
+
+    input="$1"
+    out="''${2:-./locks.json}"
+
+    # Resolve input: path or URL → temp ZIP file.
+    tmp=$(mktemp -d)
+    trap 'rm -rf "$tmp"' EXIT
+
+    zip_url=""
+    zip_sha256=""
+
+    if [ -f "$input" ]; then
+      zip="$input"
+    else
+      echo "downloading modpack ZIP from $input ..." >&2
+      # Follow redirects, capture the final URL for the snippet.
+      zip="$tmp/modpack.zip"
+      zip_url=$(curl -fL --retry 5 --retry-delay 2 \
+        -w '%{url_effective}' -o "$zip" "$input")
+    fi
+
+    # Compute the ZIP's sha256 (SRI). Useful for the paste-ready snippet.
+    zip_sha256=$(nix --extra-experimental-features nix-command \
+      hash file --type sha256 --sri "$zip")
+
+    manifest=$(unzip -p "$zip" manifest.json)
+    if [ -z "$manifest" ]; then
+      echo "error: manifest.json not found in modpack" >&2
+      exit 1
+    fi
+
+    pack_name=$(echo "$manifest" | jq -r '.name // "curseforge-pack"')
+    pack_version=$(echo "$manifest" | jq -r '.version // ""')
+    mc_version=$(echo "$manifest" | jq -r '.minecraft.version // ""')
+    primary_loader=$(echo "$manifest" \
+      | jq -r '(.minecraft.modLoaders // []) | map(select(.primary == true))[0].id // .[0].id // ""')
+    case "$primary_loader" in
+      neoforge-*)      loader_type="neoforge"; loader_version="''${primary_loader#neoforge-}" ;;
+      forge-*)         loader_type="forge";    loader_version="''${primary_loader#forge-}" ;;
+      fabric-loader-*) loader_type="fabric";   loader_version="''${primary_loader#fabric-loader-}" ;;
+      fabric-*)        loader_type="fabric";   loader_version="''${primary_loader#fabric-}" ;;
+      quilt-*)         loader_type="quilt";    loader_version="''${primary_loader#quilt-}" ;;
+      *)               loader_type="''${primary_loader%%-*}"; loader_version="''${primary_loader#*-}" ;;
+    esac
+
+    fids=$(echo "$manifest" | jq -c '[.files[] | select(.required == true) | .fileID]')
+    fid_count=$(echo "$fids" | jq 'length')
+    pids=$(echo "$manifest" | jq -c '[.files[] | select(.required == true) | .projectID] | unique')
+    pid_count=$(echo "$pids" | jq 'length')
+    echo "fetching metadata for $fid_count required files ($pid_count unique projects)..." >&2
+
+    # Bulk endpoints take up to ~50 IDs in practice; chunk and accumulate
+    # to a file (jq --argjson hits ARG_MAX on bigger chunks).
+    chunk_size=50
+    api_file="$tmp/api.jsonl"
+    : > "$api_file"
+    for ((start = 0; start < fid_count; start += chunk_size)); do
+      chunk=$(echo "$fids" | jq -c ".[$start:$start+$chunk_size]")
+      curl -sf \
+        -H "x-api-key: $CF_API_KEY" \
+        -H "Accept: application/json" \
+        -H "Content-Type: application/json" \
+        -X POST 'https://api.curseforge.com/v1/mods/files' \
+        -d "{\"fileIds\": $chunk}" \
+        | jq -c '.data[]' >> "$api_file"
+    done
+
+    # Bulk-fetch project metadata to map projectID → slug. The bulk-files
+    # endpoint above only carries modId, but consumers (fetchCurseForgeModpack
+    # + cf-exclude-include.json) match by slug.
+    mods_file="$tmp/mods.jsonl"
+    : > "$mods_file"
+    for ((start = 0; start < pid_count; start += chunk_size)); do
+      chunk=$(echo "$pids" | jq -c ".[$start:$start+$chunk_size]")
+      curl -sf \
+        -H "x-api-key: $CF_API_KEY" \
+        -H "Accept: application/json" \
+        -H "Content-Type: application/json" \
+        -X POST 'https://api.curseforge.com/v1/mods' \
+        -d "{\"modIds\": $chunk}" \
+        | jq -c '.data[] | { id, slug }' >> "$mods_file"
+    done
+
+    # Build the locks object. For mods with downloadUrl == null (CF API
+    # distribution disabled), fall back to the website redirect endpoint
+    # which works for every project.
+    manifest_file="$tmp/manifest.json"
+    echo "$manifest" > "$manifest_file"
+
+    # CF mod authors stash literal "Client"/"Server" strings inside the
+    # gameVersions array (alongside real game versions like "1.21.1") to
+    # signal intended side. We derive a 3-state side field per mod:
+    #   - both "Server" and "Client" tags -> "both"
+    #   - "Server" only                   -> "server"
+    #   - "Client" only                   -> "client"
+    #   - neither (untagged library)      -> "both"
+    # The consumer (fetchCurseForgeModpack) filters out side="client" when
+    # assembling a server install (and vice versa) and may ALSO filter
+    # using a cf-exclude-include.json — that match keys on slug, which is
+    # why each entry carries its slug.
+    jq -n --arg mc "$mc_version" --arg ltype "$loader_type" --arg lver "$loader_version" \
+      --slurpfile manifestArr "$manifest_file" \
+      --slurpfile apiArr "$api_file" \
+      --slurpfile modsArr "$mods_file" \
+      '
+        $manifestArr[0] as $manifest |
+        $apiArr as $api |
+        ($modsArr | map({key: (.id | tostring), value: .slug}) | from_entries) as $slugMap |
+        {
+          minecraft: $mc,
+          loader: { type: $ltype, version: $lver },
+          files: [
+            $manifest.files[]
+            | select(.required == true)
+            | . as $entry
+            | ($api | map(select(.id == $entry.fileID))[0]) as $file
+            | (($file.gameVersions // []) | map(ascii_downcase)) as $gv
+            | {
+                pid: $entry.projectID,
+                fid: $entry.fileID,
+                slug: ($slugMap[$entry.projectID | tostring] // ""),
+                filename: $file.fileName,
+                sha1: ($file.hashes | map(select(.algo == 1))[0].value),
+                url: ($file.downloadUrl // "https://www.curseforge.com/api/v1/mods/\($entry.projectID)/files/\($entry.fileID)/download"),
+                side: (
+                  ($gv | any(. == "server")) as $hasServer |
+                  ($gv | any(. == "client")) as $hasClient |
+                  if   $hasServer and $hasClient then "both"
+                  elif $hasServer               then "server"
+                  elif $hasClient               then "client"
+                  else                                "both"  end
+                )
+              }
+          ] | sort_by(.fid)
+        }
+      ' > "$out"
+
+    echo "wrote $fid_count entries to $out" >&2
+
+    # Paste-ready Nix snippet.
+    cat >&2 <<EOF
+
+    Drop this into your package:
+
+    ----------------------------------------------------------------------
+    {
+      pkgs,
+      fetchurl,
+    }:
+    pkgs.fetchCurseForgeModpack {
+      pname = "$(echo "$pack_name" | tr ' ' '-')";
+      version = "$pack_version";
+      src = fetchurl {
+        name = "$(echo "$pack_name" | tr ' ' '-')-$pack_version.zip";
+    EOF
+
+    if [ -n "$zip_url" ]; then
+      cat >&2 <<EOF
+        url = "$zip_url";
+    EOF
+    else
+      cat >&2 <<EOF
+        url = "<fill in: direct ZIP URL>";
+    EOF
+    fi
+
+    cat >&2 <<EOF
+        sha256 = "$zip_sha256";
+      };
+      locks = ./$(basename "$out");
+    }
+
+    EOF
+
+    mc_attr=$(echo "$mc_version" | tr . _)
+    case "$loader_type" in
+      fabric|quilt) server_ref="''${loader_type}Servers.\"''${loader_type}-$mc_attr\".override { loaderVersion = \"$loader_version\"; }" ;;
+      *)            server_ref="''${loader_type}Servers.\"''${loader_type}-$mc_attr-$(echo "$loader_version" | tr . _)\"" ;;
+    esac
+
+    cat >&2 <<EOF
+    # In your service module, the matching nix-minecraft server package is
+    # available as <modpack>.serverPackage (resolved to $server_ref).
+    ----------------------------------------------------------------------
+    EOF
+  '';
+}
