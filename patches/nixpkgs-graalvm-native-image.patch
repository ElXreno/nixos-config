diff --git a/pkgs/development/compilers/graalvm/community-edition/buildGraalvm.nix b/pkgs/development/compilers/graalvm/community-edition/buildGraalvm.nix
index ce43b3d1170f..e6718c532f3e 100644
--- a/pkgs/development/compilers/graalvm/community-edition/buildGraalvm.nix
+++ b/pkgs/development/compilers/graalvm/community-edition/buildGraalvm.nix
@@ -20,6 +20,7 @@
   libxext,
   libx11,
   zlib,
+  patchelf,
   # extra params
   extraCLibs ? [ ],
   gtkSupport ? stdenv.hostPlatform.isLinux,
@@ -52,6 +53,7 @@ let
     "libxext"
     "libx11"
     "zlib"
+    "patchelf"
     "extraCLibs"
     "gtkSupport"
     "useMusl"
@@ -85,7 +87,10 @@ let
   binPath = lib.makeBinPath (lib.optionals useMusl [ musl-gcc ] ++ [ stdenv.cc ]);
 
   runtimeLibraryPath = lib.makeLibraryPath (
-    [ cups ]
+    [
+      cups
+      zlib
+    ]
     ++ lib.optionals gtkSupport [
       cairo
       glib
@@ -127,9 +132,13 @@ let
 
       dontStrip = true;
 
+      # patchelf --set-rpath corrupts native-image; it is patched below instead.
+      dontAutoPatchelf = lib.optional stdenv.hostPlatform.isLinux true;
+
       nativeBuildInputs = [
         unzip
         makeWrapper
+        patchelf
       ]
       ++ lib.optional stdenv.hostPlatform.isLinux autoPatchelfHook;
 
@@ -209,6 +218,19 @@ let
         done
       '';
 
+      postFixup = lib.optionalString (stdenv.hostPlatform.isLinux) ''
+        nativeImageBin="$out/lib/svm/bin/native-image"
+        if [ -f "$nativeImageBin" ]; then
+          nativeImageTmp="$(mktemp -d)/native-image"
+          mv "$nativeImageBin" "$nativeImageTmp"
+          autoPatchelf -- "$out"
+          mv "$nativeImageTmp" "$nativeImageBin"
+          patchelf --set-interpreter "${stdenv.cc.bintools.dynamicLinker}" "$nativeImageBin"
+        else
+          autoPatchelf -- "$out"
+        fi
+      '';
+
       doInstallCheck = true;
       installCheckPhase = ''
         runHook preInstallCheck
