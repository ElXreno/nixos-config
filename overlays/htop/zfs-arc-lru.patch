--- a/zfs/ZfsArcStats.h
+++ b/zfs/ZfsArcStats.h
@@ -20,6 +20,7 @@ typedef struct ZfsArcStats_ {
    unsigned long long int other;
    unsigned long long int compressed;
    unsigned long long int uncompressed;
+   unsigned long long int lru;
 } ZfsArcStats;
 
 #endif
