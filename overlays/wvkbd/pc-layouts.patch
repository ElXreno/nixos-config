Subject: [PATCH 2/2] Add PC-style latin and cyrillic layouts

---
 layout.mobintl.h | 157 ++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 156 insertions(+), 1 deletion(-)

diff --git a/layout.mobintl.h b/layout.mobintl.h
index d42c19f..17840d9 100644
--- a/layout.mobintl.h
+++ b/layout.mobintl.h
@@ -26,6 +26,8 @@ enum layout_id {
 	Nav,
 	Landscape,
 	LandscapeSpecial,
+	PcLatin,
+	PcCyrillic,
 	ComposeA,
 	ComposeE,
 	ComposeY,
@@ -81,7 +83,8 @@ static struct key keys_full[], keys_full_wide[], keys_special[], keys_specialpad
